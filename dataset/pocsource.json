{
	"name": "pocsource",
	"properties": {
		"linkedServiceName": {
			"referenceName": "AzureDataLakeStorage1",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"ds_project": {
				"type": "string"
			},
			"ds_filename": {
				"type": "string"
			},
			"ds_foldername": {
				"type": "string"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "AzureBlobFSLocation",
				"fileName": {
					"value": "@dataset().ds_filename",
					"type": "Expression"
				},
				"folderPath": {
					"value": "@dataset().ds_foldername",
					"type": "Expression"
				},
				"fileSystem": {
					"value": "@dataset().ds_project",
					"type": "Expression"
				}
			},
			"compression": {
				"type": "ZipDeflate"
			}
		}
	}
}